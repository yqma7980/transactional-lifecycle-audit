{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l1_run_summary.schema.json",
  "title": "L1 material-point and one-element lifecycle summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design_version",
    "execution_status",
    "implementation_hash",
    "case_count",
    "scenario_variant_count",
    "sublevels",
    "gate_families",
    "overall_pass",
    "claim_boundary"
  ],
  "properties": {
    "design_version": {"const": "L1-D1.0"},
    "execution_status": {
      "enum": ["COMPLETE", "STOPPED_AT_MP_GATE", "STOPPED_AT_E1_GATE", "INVALID"]
    },
    "implementation_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "case_count": {"type": "integer", "const": 20},
    "scenario_variant_count": {"type": "integer", "const": 45},
    "sublevels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L1-MP", "L1-E1"],
      "properties": {
        "L1-MP": {"$ref": "#/$defs/sublevel"},
        "L1-E1": {"$ref": "#/$defs/sublevel"}
      }
    },
    "gate_families": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "overall_pass": {"type": "boolean"},
    "unsafe_seed_detected": {"type": "boolean"},
    "safe_false_positive_count": {"type": "integer", "minimum": 0},
    "ledger_rows": {"type": "integer", "minimum": 0},
    "result_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
    },
    "claim_boundary": {"type": "string", "minLength": 20}
  },
  "$defs": {
    "sublevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed_cases", "failed_cases", "blocked_cases"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "INVALID"]},
        "passed_cases": {"type": "integer", "minimum": 0},
        "failed_cases": {"type": "integer", "minimum": 0},
        "blocked_cases": {"type": "integer", "minimum": 0}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "hard_gate", "evidence"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
        "hard_gate": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
